# Copy to .env (git-ignored) and replace every value. Never commit real secrets.
# Generate passwords with:  openssl rand -hex 32
# (use URL-safe characters only: the values are embedded in connection URLs)

VYRION_ENVIRONMENT=production

# Hostname the desktop clients use (must resolve to VYRION_BIND_ADDRESS on the VPN).
VYRION_SERVER_NAME=erp.vyrncore.lan
# Address of this server on the WireGuard interface (e.g. wg0). Never 0.0.0.0.
VYRION_BIND_ADDRESS=10.8.0.1

POSTGRES_DB=vyrion
POSTGRES_USER=vyrion
POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME

# Key that encrypts secrets stored in the database (two-factor seeds). Generate one with:
#   openssl rand -base64 32 | tr '+/' '-_'
# or, once the image is built:
#   docker compose run --rm --no-deps backend python -m app.cli generate-key
# LOSING IT MAKES EVERY USER'S 2FA UNUSABLE: keep a copy outside the server (see BACKUP.md).
# To rotate: put the new key first, keep the old one after a comma, remove it later.
ENCRYPTION_KEYS=CHANGE_ME

# Two-factor authentication for administrators. When "true", an account with administrative
# permissions can do nothing but turn on 2FA until it has. Switch it on once every
# administrator has an authenticator app (an administrator who lost the phone is reset by another).
REQUIRE_2FA_FOR_ADMINS=false

# --- Backups (see docs/BACKUP.md) -------------------------------------------------
# PUBLIC age key that encrypts every backup. Generate the pair on a trusted computer, NOT here:
#   age-keygen -o vyrion-backup-key.txt      (prints "Public key: age1...")
# Keep vyrion-backup-key.txt offline (password manager + paper): without it backups are unreadable.
BACKUP_AGE_RECIPIENT=age1CHANGE_ME
# Time of the daily backup, UTC (HH:MM).
BACKUP_AT=02:30
# Optional second destination (another disk or share), as a path on the host, and where it
# appears inside the container. Leave empty to keep a single copy (not recommended: see BACKUP.md).
BACKUP_COPY_PATH=
BACKUP_COPY_DIR=
