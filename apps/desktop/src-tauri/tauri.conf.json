{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vyrion ERP",
  "version": "0.1.0",
  "identifier": "com.vyrncore.vyrion-erp",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Vyrion ERP",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost https: http://localhost:* http://127.0.0.1:*",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "publisher": "VyrnCore Enterprises",
    "copyright": "© VyrnCore Enterprises. Tutti i diritti riservati.",
    "category": "Business",
    "shortDescription": "Gestionale ERP, CRM e IT che funziona offline",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Italian", "English"],
        "compression": "lzma",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "installer/hooks.nsh",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "startMenuFolder": "VyrnCore",
        "displayLanguageSelector": false,
        "uninstallerHeaderImage": "installer/header.bmp"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 160
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 160
        },
        "background": "installer/dmg-background.png"
      },
      "signingIdentity": "-"
    },
    "longDescription": "Gestionale offline-first per ERP, CRM e IT management: i dati restano cifrati sul tuo computer; il collegamento a un server aziendale e' facoltativo.",
    "licenseFile": "installer/LICENSE.txt"
  }
}
